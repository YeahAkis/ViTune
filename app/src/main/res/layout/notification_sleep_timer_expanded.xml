<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <Chronometer
        android:id="@+id/sleep_timer_chronometer"
        style="@style/TextAppearance.Compat.Notification.Title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:singleLine="true" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/sleep_timer_subtract_5"
            style="@style/SleepTimerNotificationButton" />

        <TextView
            android:id="@+id/sleep_timer_subtract_1"
            style="@style/SleepTimerNotificationButton" />

        <TextView
            android:id="@+id/sleep_timer_add_1"
            style="@style/SleepTimerNotificationButton" />

        <TextView
            android:id="@+id/sleep_timer_add_5"
            style="@style/SleepTimerNotificationButton" />

    </LinearLayout>

</LinearLayout>
